#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/portrait_qt.py" ]]; then
  APP_DIR="$SCRIPT_DIR"
else
  APP_DIR="${PORTRAIT_APP_DIR:-$HOME/.local/opt/portrait}"
fi

resolve_repo() {
  if [[ -n "${MYSTICGSI_DIR:-}" ]]; then
    python3 -c 'import os,sys; print(os.path.realpath(os.path.expanduser(sys.argv[1])))' "$MYSTICGSI_DIR"
    return
  fi
  local config="$HOME/.config/portrait/settings.json"
  if [[ -f "$config" ]]; then
    local configured
    configured="$(python3 -c 'import json,os,sys; d=json.load(open(sys.argv[1])); print(os.path.realpath(os.path.expanduser(d.get("repo", ""))))' "$config" 2>/dev/null || true)"
    if [[ -n "$configured" && -f "$configured/cli.py" ]]; then
      printf '%s\n' "$configured"
      return
    fi
  fi
  printf '%s\n' "$HOME/mysticgsi"
}

